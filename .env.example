# Configuration reference only. The application does not auto-load this file.
# Export these values in the process environment, or edit compose.yaml for Compose.

ARL_DATA_DIR=data
ARL_DATABASE_PATH=agent-reliability-lab.db
ARL_SCENARIO_DIR=scenarios/incident-response
ARL_EVALUATION_SUITE=incident-response
ARL_EVALUATION_SUITE_DIR=scenarios/incident-response

# Comma-separated exact origins. Empty keeps the same-origin default.
ARL_CORS_ORIGINS=

# Replaces the exact API Host allowlist. Wildcards, schemes, ports, and empty
# entries are invalid. Keep web/nginx.conf server_name values aligned.
ARL_TRUSTED_HOSTS=localhost,127.0.0.1,api

# Valid range: 1..1048576 bytes.
ARL_MAX_REQUEST_BODY_BYTES=65536

# Durable new-policy-call reservations per run. Valid range: 1..1024.
# Tool retries and a reconstructed pending approval do not reserve extra slots.
ARL_MAX_ACTION_STEPS=64

# Comma-separated literal values to redact. Never commit real credentials here.
ARL_SECRET_VALUES=
